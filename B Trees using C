#include <stdio.h>
#include <stdlib.h>

#define T 3
#define MAX_KEYS (2 * T - 1)
#define MAX_CHILDREN (2 * T)

typedef struct BTreeNode {
    int keys[MAX_KEYS];
    struct BTreeNode *child[MAX_CHILDREN];
    int n;
    int leaf;
} BTreeNode;

BTreeNode *root = NULL;
void removeKey(BTreeNode *node, int key);

BTreeNode *createNode(int leaf) {
    BTreeNode *node;
    int i;

    node = (BTreeNode *)malloc(sizeof(BTreeNode));

    node->leaf = leaf;
    node->n = 0;

    for (i = 0; i < MAX_CHILDREN; i++)
        node->child[i] = NULL;

    return node;
}

void traverse(BTreeNode *node) {
    int i;

    if (node == NULL)
        return;

    for (i = 0; i < node->n; i++) {
        if (!node->leaf)
            traverse(node->child[i]);

        printf("%d ", node->keys[i]);
    }

    if (!node->leaf)
        traverse(node->child[i]);
}

BTreeNode *search(BTreeNode *node, int key) {
    int i = 0;

    if (node == NULL)
        return NULL;

    while (i < node->n && key > node->keys[i])
        i++;

    if (i < node->n && key == node->keys[i])
        return node;

    if (node->leaf)
        return NULL;

    return search(node->child[i], key);
}

void splitChild(BTreeNode *parent, int index, BTreeNode *fullChild) {
    BTreeNode *newChild;
    int i;

    newChild = createNode(fullChild->leaf);
    newChild->n = T - 1;

    for (i = 0; i < T - 1; i++)
        newChild->keys[i] = fullChild->keys[i + T];

    if (!fullChild->leaf) {
        for (i = 0; i < T; i++)
            newChild->child[i] = fullChild->child[i + T];
    }

    fullChild->n = T - 1;

    for (i = parent->n; i >= index + 1; i--)
        parent->child[i + 1] = parent->child[i];

    parent->child[index + 1] = newChild;

    for (i = parent->n - 1; i >= index; i--)
        parent->keys[i + 1] = parent->keys[i];

    parent->keys[index] = fullChild->keys[T - 1];
    parent->n++;
}

void insertNonFull(BTreeNode *node, int key) {
    int i = node->n - 1;

    if (node->leaf) {
        while (i >= 0 && key < node->keys[i]) {
            node->keys[i + 1] = node->keys[i];
            i--;
        }

        node->keys[i + 1] = key;
        node->n++;
    } else {
        while (i >= 0 && key < node->keys[i])
            i--;

        i++;

        if (node->child[i]->n == MAX_KEYS) {
            splitChild(node, i, node->child[i]);

            if (key > node->keys[i])
                i++;
        }

        insertNonFull(node->child[i], key);
    }
}

void insert(int key) {
    BTreeNode *newRoot;

    if (root == NULL) {
        root = createNode(1);
        root->keys[0] = key;
        root->n = 1;
        return;
    }

    if (search(root, key) != NULL) {
        printf("Duplicate key not allowed.\n");
        return;
    }

    if (root->n == MAX_KEYS) {
        newRoot = createNode(0);
        newRoot->child[0] = root;

        splitChild(newRoot, 0, root);

        root = newRoot;
    }

    insertNonFull(root, key);
}

int findKey(BTreeNode *node, int key) {
    int index = 0;

    while (index < node->n && node->keys[index] < key)
        index++;

    return index;
}

int getPredecessor(BTreeNode *node, int index) {
    BTreeNode *current = node->child[index];

    while (!current->leaf)
        current = current->child[current->n];

    return current->keys[current->n - 1];
}

int getSuccessor(BTreeNode *node, int index) {
    BTreeNode *current = node->child[index + 1];

    while (!current->leaf)
        current = current->child[0];

    return current->keys[0];
}

void removeFromLeaf(BTreeNode *node, int index) {
    int i;

    for (i = index + 1; i < node->n; i++)
        node->keys[i - 1] = node->keys[i];

    node->n--;
}

void merge(BTreeNode *node, int index) {
    BTreeNode *child = node->child[index];
    BTreeNode *sibling = node->child[index + 1];

    int i;

    child->keys[T - 1] = node->keys[index];

    for (i = 0; i < sibling->n; i++)
        child->keys[i + T] = sibling->keys[i];

    if (!child->leaf) {
        for (i = 0; i <= sibling->n; i++)
            child->child[i + T] = sibling->child[i];
    }

    for (i = index + 1; i < node->n; i++)
        node->keys[i - 1] = node->keys[i];

    for (i = index + 2; i <= node->n; i++)
        node->child[i - 1] = node->child[i];

    child->n += sibling->n + 1;
    node->n--;

    free(sibling);
}

void borrowFromPrevious(BTreeNode *node, int index) {
    BTreeNode *child = node->child[index];
    BTreeNode *sibling = node->child[index - 1];

    int i;

    for (i = child->n - 1; i >= 0; i--)
        child->keys[i + 1] = child->keys[i];

    if (!child->leaf) {
        for (i = child->n; i >= 0; i--)
            child->child[i + 1] = child->child[i];

        child->child[0] = sibling->child[sibling->n];
    }

    child->keys[0] = node->keys[index - 1];

    node->keys[index - 1] = sibling->keys[sibling->n - 1];

    child->n++;
    sibling->n--;
}

void borrowFromNext(BTreeNode *node, int index) {
    BTreeNode *child = node->child[index];
    BTreeNode *sibling = node->child[index + 1];

    int i;

    child->keys[child->n] = node->keys[index];

    if (!child->leaf)
        child->child[child->n + 1] = sibling->child[0];

    node->keys[index] = sibling->keys[0];

    for (i = 1; i < sibling->n; i++)
        sibling->keys[i - 1] = sibling->keys[i];

    if (!sibling->leaf) {
        for (i = 1; i <= sibling->n; i++)
            sibling->child[i - 1] = sibling->child[i];
    }

    child->n++;
    sibling->n--;
}

void fill(BTreeNode *node, int index) {
    if (index != 0 && node->child[index - 1]->n >= T)
        borrowFromPrevious(node, index);

    else if (index != node->n &&
             node->child[index + 1]->n >= T)
        borrowFromNext(node, index);

    else {
        if (index != node->n)
            merge(node, index);
        else
            merge(node, index - 1);
    }
}

void removeFromNonLeaf(BTreeNode *node, int index) {
    int key = node->keys[index];
    int predecessor;
    int successor;

    if (node->child[index]->n >= T) {
        predecessor = getPredecessor(node, index);
        node->keys[index] = predecessor;
        removeKey(node->child[index], predecessor);
    }

    else if (node->child[index + 1]->n >= T) {
        successor = getSuccessor(node, index);
        node->keys[index] = successor;
        removeKey(node->child[index + 1], successor);
    }

    else {
        merge(node, index);
        removeKey(node->child[index], key);
    }
}

void removeKey(BTreeNode *node, int key) {
    int index = findKey(node, key);
    int i;

    if (index < node->n && node->keys[index] == key) {
        if (node->leaf)
            removeFromLeaf(node, index);
        else
            removeFromNonLeaf(node, index);
    }

    else {
        if (node->leaf) {
            printf("Key %d not found.\n", key);
            return;
        }

        int flag = (index == node->n);

        if (node->child[index]->n < T)
            fill(node, index);

        if (flag && index > node->n)
            removeKey(node->child[index - 1], key);
        else
            removeKey(node->child[index], key);
    }
}

void deleteKey(int key) {
    BTreeNode *temp;

    if (root == NULL) {
        printf("Tree is empty.\n");
        return;
    }

    if (search(root, key) == NULL) {
        printf("Key %d not found.\n", key);
        return;
    }

    removeKey(root, key);

    if (root->n == 0) {
        temp = root;

        if (root->leaf)
            root = NULL;
        else
            root = root->child[0];

        free(temp);
    }

    printf("Key %d deleted successfully.\n", key);
}

void levelOrderDisplay(BTreeNode *root) {
    BTreeNode *queue[1000];
    int front = 0;
    int rear = 0;
    int levelSize;
    int i;
    int j;

    if (root == NULL) {
        printf("Tree is empty.\n");
        return;
    }

    queue[rear++] = root;

    while (front < rear) {
        levelSize = rear - front;

        for (i = 0; i < levelSize; i++) {
            BTreeNode *node = queue[front++];

            printf("[ ");

            for (j = 0; j < node->n; j++)
                printf("%d ", node->keys[j]);

            printf("] ");

            if (!node->leaf) {
                for (j = 0; j <= node->n; j++)
                    queue[rear++] = node->child[j];
            }
        }

        printf("\n");
    }
}

